//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#include "includes/key-labels.h"

#define Base        0
#define Nav         1
#define Sym         2
#define Num         3
#define Fun         4
#define Game        5
#define Media       6
#define GamePlus    7

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings =
                <&kp>,
                <&kp>;

            flavor = "balanced";
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;

            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings =
                <&kp>,
                <&kp>;

            flavor = "balanced";
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;

            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
//           ┌─────────────┬─────────────┬──────────────┬─────────────┬─────┐   ┌────────────┬─────────────┬─────────────┬─────────────┬─────────────┐           
//           │      Q      │      W      │      E       │      R      │  T  │   │     Y      │      U      │      I      │      O      │      P      │           
//           ├─────────────┼─────────────┼──────────────┼─────────────┼─────┤   ├────────────┼─────────────┼─────────────┼─────────────┼─────────────┤           
//           │ &hml lgui A │ &hml lalt S │ &hml lctl D  │ &hml lsft F │  G  │   │     H      │ &hmr rsft J │ &hmr rctl K │ &hmr ralt L │ &hmr rgui ; │           
//    ┌──────┼─────────────┼─────────────┼──────────────┼─────────────┼─────┤   ├────────────┼─────────────┼─────────────┼─────────────┼─────────────┼──────────┐
//    │ lsft │      Z      │      X      │      C       │      V      │  B  │   │     N      │      M      │      ,      │      .      │      /      │ lt Fun ' │
//    └──────┴─────────────┴─────────────┼──────────────┼─────────────┼─────┤   ├────────────┼─────────────┼─────────────┼─────────────┴─────────────┴──────────┘
//                                       │ lt Media esc │     spc     │ tab │   │ lt Sym ent │ lt Num bspc │ lt Nav del  │                                       
//                                       └──────────────┴─────────────┴─────┘   └────────────┴─────────────┴─────────────┘                                       
               &kp Q         &kp W         &kp E              &kp R           &kp T         &kp Y         &kp U          &kp I          &kp O         &kp P                                   
               &hml LGUI A   &hml LALT S   &hml LCTRL D       &hml LSHIFT F   &kp G         &kp H         &hmr RSHFT J   &hmr RCTRL K   &hmr RALT L   &hmr RGUI SEMICOLON                     
  &kp LSHIFT   &kp Z         &kp X         &kp C              &kp V           &kp B         &kp N         &kp M          &kp COMMA      &kp DOT       &kp SLASH             &lt Fun APOSTROPHE
                                           &lt Media ESCAPE   &kp SPACE       &kp TAB       &lt Sym RET   &lt Num BSPC   &lt Nav DEL                                                          
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
//          ┌─────┬─────┬─────┬─────┬─────┐   ┌───────┬─────────┬──────┬──────┬──────┐      
//          │     │     │     │     │     │   │ again │ K_PASTE │ copy │ cut  │ undo │      
//          ├─────┼─────┼─────┼─────┼─────┤   ├───────┼─────────┼──────┼──────┼──────┤      
//          │     │     │     │     │     │   │ caps  │  left   │ down │  up  │ rght │      
//    ┌─────┼─────┼─────┼─────┼─────┼─────┤   ├───────┼─────────┼──────┼──────┼──────┼─────┐
//    │     │     │     │     │     │     │   │  ins  │  home   │ pgdn │ pgup │ end  │     │
//    └─────┴─────┴─────┼─────┼─────┼─────┤   ├───────┼─────────┼──────┼──────┴──────┴─────┘
//                      │     │     │     │   │       │         │      │                    
//                      └─────┴─────┴─────┘   └───────┴─────────┴──────┘                    
           &trans   &trans   &trans   &trans   &trans       &kp K_REDO   &kp K_PASTE   &kp K_COPY   &kp K_CUT   &kp K_UNDO         
           &trans   &trans   &trans   &trans   &trans       &kp CAPS     &kp LEFT      &kp DOWN     &kp UP      &kp RIGHT          
  &trans   &trans   &trans   &trans   &trans   &trans       &kp INS      &kp HOME      &kp PG_DN    &kp PG_UP   &kp END      &kp CAPS
                             &trans   &trans   &trans       &trans       &trans        &trans                                      
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
//          ┌───┬───┬───┬───┬───┐   ┌─────┬─────┬─────┬─────┬─────┐      
//          │ { │ & │ * │ ( │ } │   │     │     │     │     │     │      
//          ├───┼───┼───┼───┼───┤   ├─────┼─────┼─────┼─────┼─────┤      
//          │ : │ $ │ % │ ^ │ + │   │     │     │     │     │     │      
//    ┌─────┼───┼───┼───┼───┼───┤   ├─────┼─────┼─────┼─────┼─────┼─────┐
//    │     │ ~ │ ! │ @ │ # │ | │   │     │     │     │     │     │     │
//    └─────┴───┴───┼───┼───┼───┤   ├─────┼─────┼─────┼─────┴─────┴─────┘
//                  │ ( │ ) │ _ │   │     │     │     │                  
//                  └───┴───┴───┘   └─────┴─────┴─────┘                  
           &kp LBRC    &kp AMPERSAND   &kp STAR      &kp LPAR    &kp RBRC        &trans   &trans   &trans   &trans   &trans         
           &kp COLON   &kp DOLLAR      &kp PERCENT   &kp CARET   &kp PLUS        &trans   &trans   &trans   &trans   &trans         
  &trans   &kp TILDE   &kp EXCL        &kp AT        &kp HASH    &kp PIPE2       &trans   &trans   &trans   &trans   &trans   &trans
                                       &kp LPAR      &kp RPAR    &kp UNDER       &trans   &trans   &trans                           
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
//          ┌───┬───┬───┬───┬───┐   ┌─────┬─────┬─────┬─────┬─────┐      
//          │ [ │ 7 │ 8 │ 9 │ ] │   │     │     │     │     │     │      
//          ├───┼───┼───┼───┼───┤   ├─────┼─────┼─────┼─────┼─────┤      
//          │ ; │ 4 │ 5 │ 6 │ = │   │     │     │     │     │     │      
//    ┌─────┼───┼───┼───┼───┼───┤   ├─────┼─────┼─────┼─────┼─────┼─────┐
//    │     │ ` │ 1 │ 2 │ 3 │ \ │   │     │     │     │     │     │     │
//    └─────┴───┴───┼───┼───┼───┤   ├─────┼─────┼─────┼─────┴─────┴─────┘
//                  │ . │ 0 │ - │   │     │     │     │                  
//                  └───┴───┴───┘   └─────┴─────┴─────┘                  
           &kp LBKT        &kp NUMBER_7   &kp NUMBER_8   &kp NUMBER_9   &kp RBKT        &trans   &trans   &trans   &trans   &trans         
           &kp SEMICOLON   &kp NUMBER_4   &kp NUMBER_5   &kp NUMBER_6   &kp EQUAL       &trans   &trans   &trans   &trans   &trans         
  &trans   &kp GRAVE       &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp BSLH        &trans   &trans   &trans   &trans   &trans   &trans
                                          &kp DOT        &kp NUMBER_0   &kp MINUS       &trans   &trans   &trans                           
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
//          ┌─────┬────┬─────┬─────┬──────┐   ┌─────┬─────┬─────┬─────┬─────────┐      
//          │ f12 │ f7 │ f8  │ f9  │ pscr │   │     │     │     │     │ to Game │      
//          ├─────┼────┼─────┼─────┼──────┤   ├─────┼─────┼─────┼─────┼─────────┤      
//          │ f11 │ f4 │ f5  │ f6  │      │   │     │     │     │     │         │      
//    ┌─────┼─────┼────┼─────┼─────┼──────┤   ├─────┼─────┼─────┼─────┼─────────┼─────┐
//    │     │ f10 │ f1 │ f2  │ f3  │      │   │     │     │     │     │         │     │
//    └─────┴─────┴────┼─────┼─────┼──────┤   ├─────┼─────┼─────┼─────┴─────────┴─────┘
//                     │     │     │      │   │     │     │     │                      
//                     └─────┴─────┴──────┘   └─────┴─────┴─────┘                      
           &kp F12   &kp F7   &kp F8   &kp F9   &kp PSCRN       &trans   &trans   &trans   &trans   &to Game         
           &kp F11   &kp F4   &kp F5   &kp F6   &trans          &trans   &trans   &trans   &trans   &trans           
  &trans   &kp F10   &kp F1   &kp F2   &kp F3   &trans          &trans   &trans   &trans   &trans   &trans     &trans
                              &trans   &trans   &trans          &trans   &trans   &trans                             
            >;
        };


        Game {
            bindings = <
//           ┌─────┬─────┬──────┬─────┬─────────────┐   ┌─────┬─────┬─────┬─────┬─────┐      
//           │     │     │      │     │             │   │     │     │     │     │     │      
//           ├─────┼─────┼──────┼─────┼─────────────┤   ├─────┼─────┼─────┼─────┼─────┤      
//           │  A  │  S  │  D   │  F  │ sl GamePlus │   │     │     │     │     │     │      
//    ┌──────┼─────┼─────┼──────┼─────┼─────────────┤   ├─────┼─────┼─────┼─────┼─────┼─────┐
//    │ lsft │     │     │      │     │             │   │     │     │     │     │     │     │
//    └──────┴─────┴─────┼──────┼─────┼─────────────┤   ├─────┼─────┼─────┼─────┴─────┴─────┘
//                       │ lctl │     │    lalt     │   │     │     │     │                  
//                       └──────┴─────┴─────────────┘   └─────┴─────┴─────┘                  
               &trans   &trans   &trans      &trans   &trans             &trans   &trans   &trans   &trans   &trans         
               &kp A    &kp S    &kp D       &kp F    &sl GamePlus       &trans   &trans   &trans   &trans   &trans         
  &kp LSHIFT   &trans   &trans   &trans      &trans   &trans             &trans   &trans   &trans   &trans   &trans   &trans
                                 &kp LCTRL   &trans   &kp LEFT_ALT       &trans   &trans   &trans                           
            >;

            display-name = "Game";
        };

        Media {
            bindings = <
//          ┌─────┬─────┬─────┬─────┬─────┐   ┌──────┬──────┬──────┬──────┬──────┐      
//          │     │     │     │     │     │   │      │      │      │      │      │      
//          ├─────┼─────┼─────┼─────┼─────┤   ├──────┼──────┼──────┼──────┼──────┤      
//          │     │     │     │     │     │   │      │ prev │ volu │ vold │ next │      
//    ┌─────┼─────┼─────┼─────┼─────┼─────┤   ├──────┼──────┼──────┼──────┼──────┼─────┐
//    │     │     │     │     │     │     │   │      │      │      │      │      │     │
//    └─────┴─────┴─────┼─────┼─────┼─────┤   ├──────┼──────┼──────┼──────┴──────┴─────┘
//                      │     │     │     │   │ stop │ play │ mute │                    
//                      └─────┴─────┴─────┘   └──────┴──────┴──────┘                    
           &trans   &trans   &trans   &trans   &trans       &trans       &trans       &trans         &trans         &trans             
           &trans   &trans   &trans   &trans   &trans       &trans       &kp C_PREV   &kp C_VOL_UP   &kp C_VOL_DN   &kp C_NEXT         
  &trans   &trans   &trans   &trans   &trans   &trans       &trans       &trans       &trans         &trans         &trans       &trans
                             &trans   &trans   &trans       &kp C_STOP   &kp C_PP     &kp C_MUTE                                       
            >;

            display-name = "Media";
        };

        GamePlus {
            bindings = <
//              ┌───┬───┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┐      
//              │ 1 │ 2 │  3  │  4  │  5  │   │     │     │     │     │     │      
//              ├───┼───┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┤      
//              │ Y │ U │  I  │  O  │     │   │     │     │     │     │     │      
//    ┌─────────┼───┼───┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┐
//    │ to Base │ N │ M │ f1  │ f2  │ f3  │   │     │     │     │     │     │     │
//    └─────────┴───┴───┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────┘
//                      │     │     │     │   │     │     │     │                  
//                      └─────┴─────┴─────┘   └─────┴─────┴─────┘                  
             &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3   &kp NUMBER_4   &kp NUMBER_5       &trans   &trans   &trans   &trans   &trans         
             &kp Y          &kp U          &kp I          &kp O          &none              &trans   &trans   &trans   &trans   &trans         
  &to Base   &kp N          &kp M          &kp F1         &kp F2         &kp F3             &trans   &trans   &trans   &trans   &trans   &trans
                                           &trans         &trans         &trans             &trans   &trans   &trans                           
            >;

            display-name = "Game+";
        };
    };
};
